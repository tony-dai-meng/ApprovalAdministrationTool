    <!-- Generate binding redirects (into ApprovalAdministrationTool.dll.config, from App.config) for the exact DLL versions
         in bin\Debug; the Debug post-build event copies it to XrmToolBox.exe.config for the F5 debug host. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
