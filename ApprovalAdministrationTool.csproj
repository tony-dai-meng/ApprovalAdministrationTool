  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!--
      XrmToolBoxPackage brings XrmToolBox.exe, XrmToolBox.Extensibility, the Dataverse SDK, McTools.Xrm.Connection,
      DockPanelSuite, ScintillaNET, WebView2 etc. transitively. Because they are copied into bin\Debug, bin\Debug is a
      runnable XrmToolBox for F5 debugging (see ApprovalAdministrationTool.csproj.user and the post-build event).
      To debug against a newer XrmToolBox, bump this version (Manage NuGet Packages > Updates).
    -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
    <!-- XrmToolBox 1.2025.10.74 is compiled against McTools.Xrm.Connection 1.2025.9.64, but its NuGet package only
         declares >= 1.2025.7.63, which fails with CS1705. Pin the connection package to the version XrmToolBox uses. -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
    <!-- Shipped with the official XrmToolBox release but no longer pulled in transitively by the packages above. -->
    <PackageReference Include="Microsoft.IdentityModel" Version="7.0.0" />
    <PackageReference Include="Microsoft.Web.Xdt" Version="3.1.0" />
    <PackageReference Include="Markdig" Version="0.41.2" />
  </ItemGroup>
