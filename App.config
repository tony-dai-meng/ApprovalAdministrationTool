<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug host configuration for XrmToolBox.
  The XrmToolBoxPackage NuGet package ships XrmToolBox.exe without its XrmToolBox.exe.config, and XrmToolBox cannot
  start without binding redirects for the libraries it depends on. This file mirrors the official XrmToolBox.exe.config
  minus the <assemblyBinding> section; the redirects are generated at build time from the exact DLL versions in bin\Debug
  (AutoGenerateBindingRedirects in the .csproj). The Debug post-build event copies the result to bin\Debug\XrmToolBox.exe.config.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
  <system.net>
    <defaultProxy enabled="true" useDefaultCredentials="true">
      <proxy autoDetect="True" bypassonlocal="False" />
    </defaultProxy>
  </system.net>
  <system.diagnostics>
    <trace autoflush="true" />
    <sources>
      <source name="Microsoft.Xrm.Tooling.Connector.CrmServiceClient" switchName="Microsoft.Xrm.Tooling.Connector.CrmServiceClient" switchType="System.Diagnostics.SourceSwitch">
        <listeners>
          <add name="console" type="System.Diagnostics.DefaultTraceListener" />
          <remove name="Default" />
          <add name="CustomListener" />
        </listeners>
      </source>
    </sources>
    <switches>
      <!-- Possible values: Off, Error, Warning, Info, Verbose -->
      <add name="Microsoft.Xrm.Tooling.Connector.CrmServiceClient" value="Verbose" />
    </switches>
    <sharedListeners>
      <add name="fileListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="XrmToolBoxConnection.log" />
      <add name="CustomListener" type="Microsoft.Xrm.Tooling.Connector.DynamicsFileLogTraceListener, Microsoft.Xrm.Tooling.Connector" BaseFileName="XrmToolBox_Connection" Location="LocalUserApplicationDirectory" MaxFileSize="52428800" />
    </sharedListeners>
  </system.diagnostics>
</configuration>
